$ python3 -m pyperformance run --rigorous -b nbody -o /project/results/nbody_r2_original.json
$ python3 -m pyperformance run --rigorous --manifest /project/nbody/optimized/locals/MANIFEST -b nbody -o /project/results/nbody_r2_locals.json
$ python3 -m pyperformance run --rigorous --manifest /project/nbody/optimized/locals_sqrt/MANIFEST -b nbody -o /project/results/nbody_r2_locals_sqrt.json
